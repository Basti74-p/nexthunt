{
  "name": "Backup",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to tenant"
    },
    "file_uri": {
      "type": "string",
      "description": "Private file URI of the backup"
    },
    "reviers_count": {
      "type": "number",
      "description": "Number of reviere in backup"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "is_automatic": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an automatic backup"
    }
  },
  "required": [
    "tenant_id",
    "file_uri"
  ]
}