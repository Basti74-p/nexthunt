{
  "name": "Aufgabe",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "revier_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "ID des Reviermitglieds oder der Person"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Anzeigename der zugewiesenen Person"
    },
    "einrichtung_id": {
      "type": "string",
      "description": "ID der Jagdeinrichtung"
    },
    "einrichtung_name": {
      "type": "string",
      "description": "Name der Jagdeinrichtung"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "offen",
        "in_bearbeitung",
        "erledigt"
      ],
      "default": "offen"
    },
    "schadensprotokolle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array von verkn\u00fcpften Schadensprotokoll-IDs"
    }
  },
  "required": [
    "tenant_id",
    "title"
  ]
}