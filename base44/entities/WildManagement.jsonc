{
  "name": "WildManagement",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "revier_id": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "rotwild",
        "schwarzwild",
        "rehwild",
        "damwild",
        "sikawild",
        "wolf"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "observation",
        "population",
        "harvest"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    }
  },
  "required": [
    "tenant_id",
    "revier_id",
    "species",
    "type",
    "date"
  ]
}