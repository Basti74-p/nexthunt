{
  "name": "JagdMeldung",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "jagd_id": {
      "type": "string"
    },
    "teilnehmer_id": {
      "type": "string"
    },
    "teilnehmer_name": {
      "type": "string"
    },
    "typ": {
      "type": "string",
      "enum": [
        "schuss",
        "erlegt",
        "sichtung",
        "bergung_angefordert",
        "bergung_erledigt",
        "nachsuche_angefordert",
        "nachsuche_laeuft",
        "nachsuche_erledigt",
        "stand_bezogen",
        "stand_verlassen",
        "jagd_start",
        "jagd_ende",
        "sonstiges"
      ],
      "description": "Art der Meldung"
    },
    "wildart": {
      "type": "string",
      "enum": [
        "rotwild",
        "schwarzwild",
        "rehwild",
        "damwild",
        "sikawild",
        "niederwild",
        "raubwild",
        "sonstiges"
      ]
    },
    "geschlecht": {
      "type": "string",
      "enum": [
        "maennlich",
        "weiblich",
        "unbekannt"
      ]
    },
    "altersklasse": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "stand_name": {
      "type": "string"
    },
    "nachricht": {
      "type": "string",
      "description": "Freitext-Nachricht"
    },
    "zeitstempel": {
      "type": "string",
      "description": "ISO Zeitstempel der Meldung"
    },
    "status": {
      "type": "string",
      "enum": [
        "neu",
        "bearbeitung",
        "erledigt"
      ],
      "default": "neu"
    },
    "bearbeitet_von": {
      "type": "string"
    },
    "wildmarke_id": {
      "type": "string"
    },
    "strecke_id": {
      "type": "string",
      "description": "Verkn\u00fcpfte Strecke nach Freigabe"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "tenant_id",
    "jagd_id",
    "typ",
    "zeitstempel"
  ]
}